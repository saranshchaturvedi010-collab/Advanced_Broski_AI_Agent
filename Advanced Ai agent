# ============================================================
# TTS
# ============================================================

def create_tts_engine():
    """Create a TTS engine that works on Linux and Windows."""
    try:
        if platform.system() == "Windows":
            engine = pyttsx3.init("sapi5")
        else:
            engine = pyttsx3.init()  # Usually uses espeak/espeak-ng on Linux.

        voices = engine.getProperty("voices")
        if voices:
            # Use the first available voice; this is more portable than
            # assuming a particular voice ID.
            engine.setProperty("voice", voices[0].id)

        engine.setProperty("rate", 175)
        engine.setProperty("volume", 1.0)
        return engine
    except Exception as exc:
        print(f"[TTS] Could not initialize: {exc}")
        return None


tts_engine = create_tts_engine()
tts_lock = threading.Lock()


def speak(text: str) -> None:
    """Speak text without crashing Broski if TTS is unavailable."""
    text = str(text).strip()
    if not text:
        return

    print(f"Broski: {text}")

    if tts_engine is None:
        return

    try:
        with tts_lock:
            tts_engine.say(text)
            tts_engine.runAndWait()
    except Exception as exc:
        print(f"[TTS] Error: {exc}")


